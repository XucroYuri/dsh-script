{
  "name": "deepseek-harness-script-studio-workspace",
  "version": "0.8.0-author-control.6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "pack:audit": "pnpm --filter @novel-studio/dsh-novel-studio pack:audit",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "check:stage1": "pnpm --filter @script-studio/domain --filter @script-studio/contracts --filter @script-studio/application check",
    "test:stage1": "pnpm --filter @script-studio/domain --filter @script-studio/contracts --filter @script-studio/application test",
    "build:stage1": "pnpm --filter @script-studio/domain --filter @script-studio/contracts --filter @script-studio/application build",
    "test:composition": "pnpm --filter @novel-studio/dsh-novel-studio test:composition",
    "test:package-install": "pnpm --filter @novel-studio/dsh-novel-studio test:package-install",
    "test:stage2:codex": "pnpm --filter @script-studio/codex-adapter test:composition",
    "test:stage2:dsh": "pnpm --filter @script-studio/dsh-adapter test:composition",
    "pack:audit:stage2:dsh": "pnpm --filter @script-studio/dsh-adapter pack:audit",
    "test:stage2:package-install": "pnpm --filter @script-studio/dsh-adapter test:package-install",
    "release:pack": "pnpm --filter @novel-studio/dsh-novel-studio release:pack"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
