{
  "name": "@script-studio/dsh-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness Bundle adapter for the Script Studio Stage 2 Host Contract",
  "keywords": ["deepseek-harness", "dsh-plugin", "screenwriting", "script-studio"],
  "homepage": "https://github.com/XucroYuri/dsh-script#readme",
  "bugs": { "url": "https://github.com/XucroYuri/dsh-script/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/XucroYuri/dsh-script.git", "directory": "plugins/dsh-script-studio" },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./adapter": { "types": "./lib/adapter.d.ts", "default": "./lib/adapter.js" },
    "./client": { "types": "./lib/client.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "package.json"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar"]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:composition": "node tests/composition-smoke.mjs"
  },
  "engines": { "node": ">=24" },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@script-studio/application": "workspace:*",
    "@script-studio/contracts": "workspace:*",
    "@script-studio/domain": "workspace:*",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.24",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
