{
  "name": "@script-studio/codex-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codex adapter for the Script Studio Host Contract v1.",
  "files": [
    ".codex-plugin",
    ".mcp.json",
    "lib",
    "mcp",
    "skills",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "precheck": "pnpm --filter @script-studio/contracts build",
    "check": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @script-studio/domain build && pnpm --filter @script-studio/contracts build && pnpm --filter @script-studio/application build && pnpm --filter @script-studio/dsh-adapter build && pnpm build",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && esbuild mcp/server.ts --bundle --platform=node --format=esm --outfile=mcp/server.mjs"
  },
  "dependencies": {
    "@script-studio/contracts": "workspace:*"
  },
  "devDependencies": {
    "@script-studio/application": "workspace:*",
    "@script-studio/domain": "workspace:*",
    "@script-studio/dsh-adapter": "workspace:*",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
